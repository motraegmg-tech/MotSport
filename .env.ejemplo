# ─────────────────────────────────────────────────────────────
# MotSport · Plantilla de variables de entorno
#
# Copia este archivo a .env y pide los valores a Gonzalo.
# .env esta bloqueado en .gitignore y NUNCA se commitea.
# Las llaves no viajan por chat ni por correo.
# ─────────────────────────────────────────────────────────────

# ── Supabase ──
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ── Claude (asistente de IA) ──
ANTHROPIC_API_KEY=
MODELO_PRINCIPAL=claude-opus-5
MODELO_ENRUTADOR=claude-haiku-4-5

# ── Fuentes deportivas ──
# Ver docs/motsport/08_FUENTES_DE_DATOS.md antes de agregar una fuente nueva:
# su licencia se documenta ANTES de escribir el conector.
API_FOOTBALL_KEY=
BALLDONTLIE_KEY=
FOOTBALL_DATA_KEY=

# ── Clima ──
# Open-Meteo no necesita llave en el tier gratuito (uso interno, no comercial).
# El plan de pago -- necesario al comercializar -- si la necesita.
# OPEN_METEO_KEY=   (solo hace falta en el plan de pago, Fase 3)

# ── Presupuestos de ingesta ──
# La fuente principal da 100 consultas al dia. La ingesta es incremental
# y con cache por diseno, no por parche.
PRESUPUESTO_DIARIO_API_FOOTBALL=100

# ── Presupuesto de IA ──
# El costo de Claude es la unica partida de operacion que puede sorprender.
# Estos topes existen para que la sorpresa sea imposible, no improbable:
# al llegar al tope el asistente se apaga y lo dice. Nunca degrada en silencio.
TOPE_DIARIO_IA_USD=5
TOPE_MENSUAL_IA_USD=80
TOPE_CONSULTAS_IA_POR_USUARIO_DIA=40
